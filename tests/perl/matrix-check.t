use v5.42;
use strict;
use warnings;
use Test::More;
use lib 'bench/lib';
use Wump::BenchMatrix qw(operations variants validate_capture validate_result compare report summarize);
use JSON::PP;
use Digest::SHA 'sha256_hex';

my %config = (version => 'v5.42.2', archname => 'x86_64-linux-thread-multi',
	cc => 'cc', gccversion => '14', ccflags => '-O2', ldflags => '', lddlflags => '-shared',
	optimize => '-O2', usemultiplicity => 'define', useithreads => 'define', use64bitall => 'define');
my $original = {
	schema => 'wump-operation-matrix-v2', complete => JSON::PP::true,
	parameters => {iterations => 2, jobs => 2, runs => 3},
	source => {revision => 'a' x 40, fixture_sha256 => 'b' x 64, dirty => JSON::PP::false},
	machine => {cpu_model => 'test CPU', affinity => '0-3', kernel => 'test kernel'},
	binaries => {
		wump => {path => '/wump', sha256 => sha256_hex('wump'), config => {%config, wump => 1}},
		stock => {path => '/stock', sha256 => sha256_hex('stock'), config => {%config, wump => 0}},
		go => {path => '/go', sha256 => sha256_hex('go'), config => {version => 'go1', os => 'linux', arch => 'amd64', compiler => 'gc', settings => []}},
	}, cells => [],
};
# Literal observations for two iterations and two job seeds. They are not
# generated by the implementation's checksum-reference function.
my %checksums = (arithmetic => [3, 5], calls => [5, 7], arrays => [24, 32],
	hashes => [8, 12], strings => [22, 22], regex => [11, 13], utf8 => [919, 921],
	json => [36, 36], yield => [2], spawn => [3], channel => [3]);
my @ops = operations();
my @variants = variants();
for my $op_index (0..$#ops) {
	my $op = $ops[$op_index];
	for my $variant_index (0..$#variants) {
		my $variant = $variants[$variant_index];
		my $slots = $variant =~ /-(1|2|4)\z/ ? 0 + $1 : 0;
		my @samples;
		for my $run (1..3) {
			my %sample = (operation => $op, slots => $slots, iterations => 2, jobs => 2, run => $run,
				sequence => ($run - 1) * @ops * @variants + $op_index * @variants + ($variant_index - $run + 1 + @variants) % @variants + 1);
			if ($op =~ /\A(?:spawn|yield|channel)\z/ && (!$slots || $variant =~ /\A(?:fork|ithreads)-/)) {
				%sample = (%sample, status => 'unsupported', reason => 'no coroutine runtime in this mode');
			} elsif ($op eq 'json' && $variant =~ /\Awump-[24]\z/) {
				%sample = (%sample, status => 'unsupported', reason => 'parallel XS admission: utf8::encode',
					detail => 'Wump: XS function has not declared parallel safety: utf8::encode');
			} else {
				my @results;
				for my $id (1..@{$checksums{$op}}) {
					my @r = ($id, $checksums{$op}[$id - 1]);
					push @r, '{"n":' . ($id + 1) . ',"s":"word"}' if $op eq 'json';
					push @results, \@r;
				}
				%sample = (%sample, status => 'ok', units => $op =~ /\A(?:spawn|yield|channel)\z/ ? 2 : 4,
					wall_seconds => 0.001 * $run, process_seconds => 0.01 + 0.001 * $run, results => \@results);
			}
			push @samples, \%sample;
		}
		push @{$original->{cells}}, {operation => $op, variant => $variant, samples => \@samples};
	}
}
sub clone ($value = $original) { return decode_json(encode_json($value)) }
sub cell ($capture, $op = 'arithmetic', $variant = 'wump-1') {
	return (grep {$_->{operation} eq $op && $_->{variant} eq $variant} @{$capture->{cells}})[0];
}
sub check ($candidate, $before = $original, $limit = 10) {
	validate_capture($before);
	validate_capture($candidate);
	return compare($before, $candidate, $limit);
}
ok(validate_capture($original), 'complete literal three-language fixture validates');
{
	my $legacy = clone();
	$legacy->{schema} = 'wump-operation-matrix-v1';
	$legacy->{cells} = [grep {$_->{variant} !~ /\A(?:fork|ithreads)-/} @{$legacy->{cells}}];
	my $sequence = 0;
	for my $cell (@{$legacy->{cells}}) { $_->{sequence} = ++$sequence for @{$cell->{samples}} }
	ok(validate_capture($legacy), 'archived v1 captures remain readable');
	like(report($legacy), qr/Stock Perl.*Wump unused.*Go 4/, 'archived v1 report retains its original columns');
	unlike(report($legacy), qr/ithreads 1/, 'archived captures do not fabricate new controls');
	my ($failed) = compare($legacy, clone($legacy), 10);
	is($failed, 0, 'archived v1 comparisons remain usable');
	ok(!eval {compare($legacy, $original, 10); 1}, 'schemas cannot be compared across different variant sets');
}
like(report($original), qr/Fork 1.*Fork 2.*Fork 4.*ithreads 1.*ithreads 2.*ithreads 4/, 'report includes each process and thread count');
{
	my $bad = clone();
	$bad->{binaries}{stock}{config}{useithreads} = '';
	$bad->{binaries}{wump}{config}{useithreads} = '';
	ok(!eval {validate_capture($bad); 1}, 'new matrix requires an ithreads-capable stock control');
}
my ($failed, $text) = check(clone());
is($failed, 0, 'identical matrices pass');
like($text, qr/PASS arithmetic wump-unused work/, 'unused fork is covered');
like($text, qr/PASS channel wump-4 process/, 'coroutine process overhead is covered');
like($text, qr/N\/A json wump-4/, 'known unsupported work remains visible');
my $summary = summarize($original);
is($summary->{arithmetic}{stock}{work}, 500000, 'work medians are recomputed per operation');
is($summary->{arithmetic}{stock}{process}, 12, 'process medians remain separate');
like(report($original), qr/Stock Perl.*Wump unused.*Go 4/, 'report includes every requested comparison');
like(report($original), qr/parallel XS admission: utf8::encode/, 'report names unsupported boundaries');
like(report($original), qr/Unused \/ stock.*Wump 1 \/ Go 1/, 'report makes stock and Go reference ratios visible');
like(report($original, 'process'), qr/whole-process milliseconds/, 'process report states its units');

for my $factor (0.5, 1.1, 1.11) {
	my $c = clone();
	$_->{wall_seconds} *= $factor for @{cell($c)->{samples}};
	($failed, $text) = check($c);
	is($failed, $factor > 1.1 ? 1 : 0, "work factor $factor respects the budget and exact boundary");
}
{
	my $c = clone();
	$_->{wall_seconds} *= 1.09 for @{cell($c)->{samples}};
	($failed) = check($c, $original, 5);
	is($failed, 1, 'an explicit tighter budget is enforced');
	($failed) = check(clone(), $original, 0);
	is($failed, 0, 'zero budget accepts identical measurements');
}
{
	my $c = clone();
	$_->{process_seconds} *= 1.11 for @{cell($c, 'channel', 'wump-4')->{samples}};
	($failed, $text) = check($c);
	is($failed, 1, 'process regression fails independently');
	like($text, qr/FAIL channel wump-4 process/, 'regression identifies the operation, mode and metric');
}
{
	my $c = clone();
	for my $cell (grep {$_->{variant} =~ /^go-/} @{$c->{cells}}) {
		for my $sample (@{$cell->{samples}}) { $_ *= 0.001 for @{$sample}{qw(wall_seconds process_seconds)} }
	}
	($failed) = check($c);
	is($failed, 0, 'getting much farther from Go does not fail a Wump progress gate');
}
{
	my $c = clone();
	$c->{binaries}{wump}{sha256} = 'c' x 64;
	$c->{source}{revision} = 'd' x 40;
	($failed) = check($c);
	is($failed, 0, 'new Wump builds and source revisions are comparable');
}
{
	my $supported = clone();
	my $source = cell($supported, 'json', 'wump-1');
	for my $variant (qw(wump-2 wump-4)) {
		my $target = cell($supported, 'json', $variant);
		my @sequences = map {$_->{sequence}} @{$target->{samples}};
		$target->{samples} = clone($source->{samples});
		for my $index (0..$#sequences) {
			$target->{samples}[$index]{slots} = $variant eq 'wump-2' ? 2 : 4;
			$target->{samples}[$index]{sequence} = $sequences[$index];
		}
	}
	($failed, $text) = check($supported);
	is($failed, 0, 'newly supported work is accepted');
	like($text, qr/NEW json wump-4/, 'new support is distinguished from an established timing baseline');
	($failed, $text) = check(clone(), $supported);
	is($failed, 1, 'losing previously working support fails');
	like($text, qr/FAIL json wump-4: support lost/, 'lost support cannot become an attractive N/A timing');
}

for my $case (
	['missing cell', sub {pop @{$_[0]{cells}}}, qr/incomplete matrix cells/],
	['duplicate cell', sub {$_[0]{cells}[1] = $_[0]{cells}[0]}, qr/duplicate matrix cell/],
	['unknown row', sub {$_[0]{cells}[0]{operation} = 'other'}, qr/unknown matrix cell/],
	['missing sample', sub {pop @{cell($_[0])->{samples}}}, qr/incomplete matrix samples/],
	['duplicate run', sub {cell($_[0])->{samples}[0]{run} = 2}, qr/duplicate or invalid sample/],
	['duplicate sequence', sub {cell($_[0])->{samples}[0]{sequence} = cell($_[0])->{samples}[1]{sequence}}, qr/duplicate or invalid execution sequence/],
	['wrong checksum', sub {cell($_[0])->{samples}[0]{results}[0][1]++}, qr/incorrect job checksum/],
	['duplicate job', sub {cell($_[0])->{samples}[0]{results}[1][0] = 1}, qr/duplicate or invalid job/],
	['missing job', sub {pop @{cell($_[0])->{samples}[0]{results}}}, qr/incomplete job results/],
	['wrong JSON', sub {cell($_[0], 'json')->{samples}[0]{results}[0][2] = '{"n":9,"s":"word"}'}, qr/incorrect JSON payload/],
	['wrong units', sub {cell($_[0])->{samples}[0]{units}++}, qr/invalid operation count/],
	['wrong slots', sub {cell($_[0])->{samples}[0]{slots} = 4}, qr/worker identity mismatch/],
	['unverified status', sub {cell($_[0])->{samples}[0]{status} = 'ok-ish'}, qr/invalid worker timing or status/],
	['zero time', sub {cell($_[0])->{samples}[0]{wall_seconds} = 0}, qr/invalid worker timing/],
	['nonfinite time', sub {cell($_[0])->{samples}[0]{wall_seconds} = 'NaN'}, qr/invalid worker timing/],
	['impossible process time', sub {cell($_[0])->{samples}[0]{process_seconds} = 0.00001}, qr/invalid process timing/],
	['timed N/A', sub {cell($_[0], 'json', 'wump-4')->{samples}[0]{wall_seconds} = 0.1}, qr/unsupported result contains measurements/],
	['hidden error', sub {cell($_[0], 'json', 'wump-4')->{samples}[0]{detail} = 'other failure'}, qr/unexpected unsupported/],
	['incomplete capture', sub {$_[0]{complete} = JSON::PP::false}, qr/incomplete or unknown matrix/],
	['new schema', sub {$_[0]{schema} = 'v99'}, qr/unknown matrix schema/],
	['invalid jobs', sub {$_[0]{parameters}{jobs} = 0}, qr/invalid matrix parameters/],
	['missing build', sub {delete $_[0]{binaries}{go}}, qr/missing binary identity/],
	['wrong stock role', sub {$_[0]{binaries}{stock}{config}{wump} = 1}, qr/wrong Perl interpreter role/],
	['different Perl flags', sub {$_[0]{binaries}{stock}{config}{optimize} = '-O0'}, qr/stock\/Wump build mismatch/],
	['instrumented Perl', sub {$_[0]{binaries}{wump}{config}{ccflags} .= ' -fsanitize=address'}, qr/instrumented Perl/],
	['instrumented Go', sub {push @{$_[0]{binaries}{go}{config}{settings}}, {Key => '-race', Value => 'true'}}, qr/instrumented or custom/],
	['invalid affinity', sub {$_[0]{machine}{affinity} = '0 1'}, qr/invalid CPU affinity/],
) {
	my ($name, $edit, $pattern) = @$case;
	my $c = clone();
	$edit->($c);
	my $ok = eval {validate_capture($c); 1};
	ok(!$ok, "$name cannot pass schema/result validation");
	like($@, $pattern, 'invalid evidence is identified');
}
for my $case (
	['dirty source', sub {$_[0]{source}{dirty} = JSON::PP::true}, qr/clean source/],
	['too few runs', sub {$_[0]{parameters}{runs} = 2; splice @{$_->{samples}}, 2 for @{$_[0]{cells}}}, qr/at least three runs/],
	['different fixture', sub {$_[0]{source}{fixture_sha256} = 'c' x 64}, qr/different benchmark fixtures/],
	['different CPU', sub {$_[0]{machine}{cpu_model} = 'other'}, qr/incompatible comparison: machine/],
	['different affinity', sub {$_[0]{machine}{affinity} = '0-7'}, qr/incompatible comparison: machine/],
	['new stock binary', sub {$_[0]{binaries}{stock}{sha256} = 'c' x 64}, qr/changed stock control/],
	['new Go binary', sub {$_[0]{binaries}{go}{sha256} = 'c' x 64}, qr/changed go control/],
) {
	my ($name, $edit, $pattern) = @$case;
	my $c = clone(); $edit->($c);
	my $ok = eval {check($c); 1};
	ok(!$ok, "$name cannot pass a baseline comparison");
	like($@, $pattern, 'comparison mismatch is identified');
}
for my $limit (-1, 101, 'NaN', []) {
	ok(!eval {check(clone(), $original, $limit); 1}, 'invalid regression budget fails');
}
done_testing;
