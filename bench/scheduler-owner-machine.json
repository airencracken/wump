   "reproduction" : {
      "perl_capture_shell" : "#!/bin/bash\nwump_checkpoint=/home/marcus/projects/wump/master/build/checkpoint-runtime-owner\nprintf '%s\\n' 'variant,run,implementation,workload,workers,operations,seconds,ns_per_op' > \"$wump_checkpoint/perl.csv\"\nfor wump_run in 1 2 3 4 5; do\n\tfor wump_slots in 1 4; do\n\t\tif [ \"$wump_slots\" -eq 1 ]; then wump_cpus=0; else wump_cpus=0,2,4,6; fi\n\t\tif [ \"$((wump_run % 2))\" -eq 1 ]; then wump_variants=(before after); else wump_variants=(after before); fi\n\t\tfor wump_variant in \"${wump_variants[@]}\"; do\n\t\t\tcase \"$wump_variant\" in\n\t\t\t\tbefore) wump_perl=/home/marcus/projects/wump/master/build/perl/perl-5.42.2/perl ;;\n\t\t\t\tafter) wump_perl=\"$wump_checkpoint/integration/perl/perl-5.42.2/perl\" ;;\n\t\t\tesac\n\t\t\twump_lib=$(dirname -- \"$wump_perl\")/lib\n\t\t\twump_output=\"$wump_checkpoint/perl-$wump_variant-$wump_run-$wump_slots.csv\"\n\t\t\tWUMPPROCS=\"$wump_slots\" timeout 180s taskset -c \"$wump_cpus\" \"$wump_perl\" \"-I$wump_lib\" -I/home/marcus/projects/wump/master/perl/lib \"$wump_checkpoint/perl-primitives.pl\" 20000 > \"$wump_output\"\n\t\t\twump_result=$?\n\t\t\tif [ \"$wump_result\" -ne 0 ]; then printf 'Perl benchmark failed: %s\\n' \"$wump_output\" >&2; exit \"$wump_result\"; fi\n\t\t\tawk -v variant=\"$wump_variant\" -v run=\"$wump_run\" 'NR > 1 { print variant \",\" run \",\" $0 }' \"$wump_output\" >> \"$wump_checkpoint/perl.csv\"\n\t\t\twump_result=$?\n\t\t\tif [ \"$wump_result\" -ne 0 ]; then exit \"$wump_result\"; fi\n\t\tdone\n\tdone\ndone\n",
      "perl_fixture_source" : "use v5.42;\nuse strict;\nuse warnings;\nuse Wump;\nuse Time::HiRes qw(clock_gettime CLOCK_MONOTONIC);\nBEGIN { CLOCK_MONOTONIC() }\n\n@ARGV == 1 && $ARGV[0] =~ /\\A[1-9][0-9]*\\z/ && $ARGV[0] <= 1000000 or die \"iterations required\\n\";\nmy $count = $ARGV[0];\nsub report ($name, $start) {\n\tmy $seconds = clock_gettime(CLOCK_MONOTONIC) - $start;\n\tprintf \"perl,%s,%d,%d,%.9f,%.1f\\n\", $name, Wump::execution_slots(), $count,\n\t\t$seconds, $seconds * 1e9 / $count;\n}\nprint \"implementation,workload,workers,operations,seconds,ns_per_op\\n\";\nmy $start = clock_gettime(CLOCK_MONOTONIC);\nyield for 1..$count;\nreport('yield', $start);\nmy ($request, $response, $done) = (chan, chan, chan);\n$start = clock_gettime(CLOCK_MONOTONIC);\nact {\n\tfor (1..$count) {\n\t\tmy $value = $request->recv;\n\t\t$response->send($value + 1);\n\t}\n\t$done->send(1);\n};\nfor my $value (0..$count - 1) {\n\t$request->send($value);\n\tmy $reply = $response->recv;\n\tdie \"incorrect pingpong value\\n\" unless $reply == $value + 1;\n}\ndie \"worker did not complete\\n\" unless $done->recv == 1;\nreport('pingpong', $start);\n",
      "runtime_capture_shell" : "#!/bin/bash\nwump_checkpoint=/home/marcus/projects/wump/master/build/checkpoint-runtime-owner\nprintf '%s\\n' 'variant,run,implementation,workload,workers,operations,seconds,ns_per_op' > \"$wump_checkpoint/runtime.csv\"\nfor wump_run in 1 2 3 4 5; do\n\tfor wump_slots in 1 4; do\n\t\tif [ \"$wump_slots\" -eq 1 ]; then wump_cpus=0; else wump_cpus=0,2,4,6; fi\n\t\twump_variants=(before after go)\n\t\tfor wump_offset in 0 1 2; do\n\t\t\twump_variant=${wump_variants[$(( (wump_offset + wump_run - 1) % 3 ))]}\n\t\t\tcase \"$wump_variant\" in\n\t\t\t\tgo) wump_binary=\"$wump_checkpoint/before/go-bench\" ;;\n\t\t\t\t*) wump_binary=\"$wump_checkpoint/$wump_variant/bench\" ;;\n\t\t\tesac\n\t\t\twump_output=\"$wump_checkpoint/runtime-$wump_variant-$wump_run-$wump_slots.csv\"\n\t\t\ttimeout 180s taskset -c \"$wump_cpus\" \"$wump_binary\" 100000 \"$wump_slots\" > \"$wump_output\"\n\t\t\twump_result=$?\n\t\t\tif [ \"$wump_result\" -ne 0 ]; then printf 'Benchmark failed: %s\\n' \"$wump_output\" >&2; exit \"$wump_result\"; fi\n\t\t\tawk -v variant=\"$wump_variant\" -v run=\"$wump_run\" 'NR > 1 { print variant \",\" run \",\" $0 }' \"$wump_output\" >> \"$wump_checkpoint/runtime.csv\"\n\t\t\twump_result=$?\n\t\t\tif [ \"$wump_result\" -ne 0 ]; then exit \"$wump_result\"; fi\n\t\tdone\n\tdone\ndone\n",
